<% content_for :title, "Billetto Events" %>

<div class="events-page">
  <header class="events-header">
    <h1>Billetto Events</h1>
    <%= button_to "Sync Events", sync_events_path, method: :post, class: "sync-btn" %>
  </header>

  <% if @events.none? %>
    <div class="events-empty">
      <p>No events found. Click <strong>Sync Events</strong> to fetch from Billetto.</p>
    </div>
  <% else %>
    <ul class="events-list">
      <% @events.each do |event| %>
        <li class="event-card">
          <% if event.image_url.present? %>
            <div class="event-card__image">
              <%= image_tag event.image_url, alt: event.title, loading: "lazy" %>
            </div>
          <% end %>

          <div class="event-card__body">
            <h2 class="event-card__title">
              <% if event.url.present? %>
                <%= link_to event.title, event.url, target: "_blank", rel: "noopener noreferrer" %>
              <% else %>
                <%= event.title %>
              <% end %>
            </h2>

            <% if event.starts_at.present? %>
              <p class="event-card__date">
                <time datetime="<%= event.starts_at.iso8601 %>">
                  <%= event.starts_at.strftime("%A, %d %B %Y at %H:%M") %>
                </time>
                <% if event.ends_at.present? %>
                  &ndash;
                  <time datetime="<%= event.ends_at.iso8601 %>">
                    <%= event.ends_at.strftime("%H:%M") %>
                  </time>
                <% end %>
              </p>
            <% end %>

            <% if event.description.present? %>
              <p class="event-card__description"><%= truncate(event.description, length: 200) %></p>
            <% end %>

            <div class="event-card__footer">
              <% if event.status.present? %>
                <span class="event-card__status event-card__status--<%= event.status.downcase %>">
                  <%= event.status.humanize %>
                </span>
              <% end %>

              <div class="event-card__vote">
                <% if clerk.session %>
                  <%= turbo_frame_tag "event-vote-#{event.id}" do %>
                    <span class="vote-count">&#9829; <%= event.votes.size %></span>
                    <% if @user_voted_ids.include?(event.id) %>
                      <span class="vote-btn vote-btn--voted">Voted</span>
                    <% else %>
                      <%= button_to "Vote", event_votes_path(event),
                            method: :post,
                            class: "vote-btn vote-btn--active" %>
                    <% end %>
                  <% end %>
                <% else %>
                  <span class="vote-count">&#9829; <%= event.votes.size %></span>
                  <a href="<%= clerk.sign_in_url %>?redirect_url=<%= CGI.escape(request.url) %>"
                     class="vote-btn vote-btn--guest">Sign in to vote</a>
                <% end %>
              </div>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>

<style>
  * { box-sizing: border-box; }
  body { font-family: system-ui, sans-serif; margin: 0; background: #f5f5f5; color: #222; }

  .events-page { max-width: 900px; margin: 0 auto; padding: 2rem 1rem; }

  .events-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; }
  .events-header h1 { margin: 0; font-size: 1.8rem; }

  .sync-btn {
    background: #e44646; color: #fff; border: none; padding: 0.55rem 1.2rem;
    border-radius: 6px; font-size: 0.9rem; cursor: pointer; font-weight: 600;
  }
  .sync-btn:hover { background: #c73030; }

  .flash { padding: 0.75rem 1rem; border-radius: 6px; margin-bottom: 1rem; }
  .flash--notice { background: #d4edda; color: #155724; }
  .flash--alert  { background: #f8d7da; color: #721c24; }

  .events-empty { text-align: center; padding: 3rem; color: #666; }

  .events-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }

  .event-card {
    background: #fff; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,.07);
    display: flex; overflow: hidden;
  }

  .event-card__image { flex: 0 0 180px; }
  .event-card__image img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .event-card__body { padding: 1rem 1.25rem; flex: 1; display: flex; flex-direction: column; gap: 0.4rem; }

  .event-card__title { margin: 0; font-size: 1.1rem; }
  .event-card__title a { color: #e44646; text-decoration: none; }
  .event-card__title a:hover { text-decoration: underline; }

  .event-card__date { margin: 0; font-size: 0.85rem; color: #555; }

  .event-card__description { margin: 0; font-size: 0.9rem; color: #444; line-height: 1.5; }

  .event-card__status {
    display: inline-block; font-size: 0.75rem; font-weight: 600; padding: 0.2rem 0.6rem;
    border-radius: 4px; text-transform: uppercase; letter-spacing: .05em;
    background: #eee; color: #555; align-self: flex-start;
  }
  .event-card__status--published { background: #d4edda; color: #155724; }
  .event-card__status--cancelled { background: #f8d7da; color: #721c24; }
  .event-card__status--draft     { background: #fff3cd; color: #856404; }

  .event-card__footer { display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: .5rem; }

  .event-card__vote { display: flex; align-items: center; gap: .5rem; }
  .vote-count { font-size: .85rem; color: #e44646; font-weight: 600; }

  .vote-btn {
    font-size: .8rem; font-weight: 600; padding: .25rem .75rem;
    border-radius: 5px; cursor: pointer; border: none; text-align: center;
  }
  .vote-btn--active { background: #e44646; color: #fff; }
  .vote-btn--active:hover { background: #c73030; }
  .vote-btn--voted  { background: #eee; color: #888; cursor: default; }
  .vote-btn--guest  { background: transparent; color: #e44646; border: 1px solid #e44646; text-decoration: none; }

  @media (max-width: 600px) {
    .event-card { flex-direction: column; }
    .event-card__image { flex: none; height: 180px; }
    .events-header { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
  }
</style>
